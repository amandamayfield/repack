# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Defaults to False (production). Set True for local development.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional, comma-separated. Defaults to the Vite dev server origins.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://repack.example.com
# HTTPS redirect + secure cookies + HSTS. Defaults to the opposite of DJANGO_DEBUG.
# DJANGO_SECURE=True
# Set True only when deployed behind a proxy/load balancer that sets X-Forwarded-Proto.
# DJANGO_BEHIND_PROXY=True
POSTGRES_DB=repack
POSTGRES_USER=repack
POSTGRES_PASSWORD=repack
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
